{
  "name": "chess-io",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Шахматы в браузере: локальная игра и компьютер, полные правила и сохранение партий",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run vendor -- --check && npm test && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
